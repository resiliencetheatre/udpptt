# Copy to operator.env and populate your own settings.
# Literal KEY=VALUE; no quotes, export, inline comments or shell expansion.
# Use absolute paths. Spaces and special characters in values are literal.
# Existing environment variables override this file; CLI options override both.
OPERATOR_SERVER=
OPERATOR_TXID=
OPERATOR_KEY=
OPERATOR_PREAMBLE_ID=
OPERATOR_INPUT_DIR=
OPERATOR_OUTPUT_DIR=
OPERATOR_STATE_FILE=
# Optional executable override; omit to use the adjacent repository's gate.
# OPERATOR_GATE=/absolute/path/to/ptt_wav_gate
OPERATOR_KOKORO=kokoro-offline
OPERATOR_VOICE=af_heart
OPERATOR_LANGUAGE=a
WHISPER_BIN=whisper-cli
WHISPER_MODEL=
OPERATOR_JITTER_MS=200
OPERATOR_FEC_LOSS_PERCENT=10
OPERATOR_RX_STATE_TIMEOUT_MS=1000
